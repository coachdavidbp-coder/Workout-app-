# Copy this file to ".env" and fill in from your Firebase web app config.
# Leaving these blank runs the app in local-only mode (no login, data on-device).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Optional but recommended for accurate food search (Costco, fast food, brands).
# Free instant key: https://fdc.nal.usda.gov/api-key-signup.html
# Without it, food search still works via Open Food Facts.
VITE_USDA_KEY=Z2sVIb4zDi054SZ64BGk0Da1fpbbRvdbsHq2pq5V

# Optional — plays recipe how-to videos INSIDE the app instead of linking out.
# Free: console.cloud.google.com → new project → enable "YouTube Data API v3"
# → Credentials → Create API key → paste it here.
# Each recipe is looked up once and cached on the device, so the free quota
# (~100 lookups/day) goes a long way. Blank = tap-to-open YouTube links.
VITE_YOUTUBE_API_KEY=

# Optional — Spotify "now playing" during workouts (like Nike's).
# Free: create an app at https://developer.spotify.com/dashboard,
# add your deployed site URL as a Redirect URI, and paste the Client ID here.
# No client secret needed (uses PKCE). Leaving it blank shows a plain
# "open Spotify" button instead.
VITE_SPOTIFY_CLIENT_ID=707a5dda29424a22944422f3fc761714
