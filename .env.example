# Copy this file to ".env" and fill in from your Firebase web app config.
# Leaving these blank runs the app in local-only mode (no login, data on-device).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Optional but recommended for accurate food search (Costco, fast food, brands).
# Free instant key: https://fdc.nal.usda.gov/api-key-signup.html
# Without it, food search still works via Open Food Facts.
VITE_USDA_KEY=
